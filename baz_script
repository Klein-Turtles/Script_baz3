-- 🧩 Load Rayfield UI
local success, Rayfield = pcall(function() 
    return loadstring(game:HttpGet('https://sirius.menu/rayfield'))() 
end)

if not success then warn("Gagal load Rayfield!") return end

local Window = Rayfield:CreateWindow({
    Name = "Zoo Admin Sniper v6 (Machine Fix)",
    LoadingTitle = "Bypassing Machine Protocols...",
    LoadingSubtitle = "by Tegar",
    ConfigurationSaving = {Enabled = false}
})

local Tab = Window:CreateTab("Sniper Shop", nil)
local MachineTab = Window:CreateTab("Machines", nil) -- Tab baru buat mesin

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local AdminRE = ReplicatedStorage:WaitForChild("Remote"):WaitForChild("AdminAbuseRE")

-- 🛠️ Fungsi Buka Mesin (Bypass)
local function openMachine(machineName)
    -- Biasanya jalurnya ada di RemoteFunctions -> Interaction atau MachineRE
    local InteractionRF = ReplicatedStorage:FindFirstChild("RemoteFunctions") and ReplicatedStorage.RemoteFunctions:FindFirstChild("Interaction")
    
    if InteractionRF then
        print("🔧 Opening: " .. machineName)
        InteractionRF:InvokeServer(machineName) -- Nembak server buat minta UI
        
        Rayfield:Notify({
            Title = "Machine Triggered",
            Content = "Membuka " .. machineName .. " secara paksa!",
            Duration = 3
        })
    else
        -- Jalur alternatif kalau InteractionRF gak ada
        warn("Remote interaction gak ketemu, Gar!")
    end
end

